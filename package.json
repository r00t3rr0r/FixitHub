{
  "name": "FixitHub",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "concurrently -n \"client,server\" \"npm run client-install\" \"npm run server-install\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:admin-bookings-read-flow": "node test-admin-bookings-read-flow.js",
    "test:admin-bookings-read-flow:multi-order": "node test-admin-bookings-read-flow-multi-order.js",
    "client": "cd client && npm run dev",
    "client-install": "cd client && npm install",
    "server": "npm --prefix server run dev:clean",
    "server-install": "cd server && npm install",
    "start": "concurrently -n \"client,server\" \"npm run client\" \"npm run server\"",
    "debug": "concurrently -n \"client,server\" \"npm run client\" \"cross-env NODE_OPTIONS=--inspect-brk=9229 npm --prefix server run dev:clean\""
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.15.2",
    "concurrently": "^9.1.0",
    "dotenv": "^17.4.2",
    "hover.css": "^2.3.2",
    "mongoose": "^9.5.0",
    "papaparse": "^5.5.3",
    "ua-parser-js": "^2.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "cross-env": "^7.0.3"
  }
}
