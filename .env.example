# Server Configuration
PORT=3000
NODE_ENV=development
TRACKING_SALT=<tracking-salt: 32 random bytes as hex>
# Database Configuration
# MongoDB connection string - Update with your MongoDB credentials
# For local MongoDB without auth: mongodb://localhost:27017/FixitHub
# For local MongoDB with auth: mongodb://username:password@localhost:27017/FixitHub?authSource=admin
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/FixitHub?retryWrites=true&w=majority
DATABASE_URL=<mongodb-connection-string>

# Optional: Separate MongoDB credentials (alternative to including in DATABASE_URL)
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_AUTH_SOURCE=admin

# JWT Configuration
# These secrets should be long, random strings in production
# You can generate secure secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<jwt-secret: 64 random bytes as hex>
REFRESH_TOKEN_SECRET=<refresh-token-secret: 64 random bytes as hex, different from JWT_SECRET>

# Session Configuration
SESSION_SECRET=<session-secret: 64 random bytes as hex>

# Initial admin account (admin@example.com)
# Only used when NO admin exists yet; an existing admin is never modified.
# REQUIRED in production: without it no admin is created.
# In development an unset value yields a random password that is printed once in the server log.
# SEED_ADMIN_PASSWORD=<seed-admin-password: strong, unique>

# Email Configuration (optional - for sending notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./server/uploads

# Application URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000

# API Keys (optional)
# Add any third-party API keys here
# MOBILEAPI_KEY=your-mobileapi-dev-key
# STRIPE_SECRET_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
