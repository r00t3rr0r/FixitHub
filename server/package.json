{
  "name": "fixithub-server",
  "version": "1.0.0",
  "description": "FixitHub device repair platform backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:clean": "sh -c 'PIDS=$(lsof -tiTCP:3000 -sTCP:LISTEN); if [ -n \"$PIDS\" ]; then echo \"Releasing port 3000 (PID: $PIDS)\"; kill -9 $PIDS; fi; sleep 1; exec nodemon server.js'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "setup-mongodb": "node scripts/setup-mongodb-auth.js",
    "setup-env": "node scripts/setup-env.js",
    "seed": "node scripts/seed-data.js",
    "seed:german:workflows": "node scripts/seed-german-workflows.js",
    "reset-db": "node scripts/reset-database.js",
    "verify-admin": "node scripts/verify-admin.js",
    "test-login": "node scripts/test-login.js"
  },
  "keywords": [
    "repair",
    "device",
    "service",
    "platform"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.23.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.13.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
