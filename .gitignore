server/node_modules/
server/.env
server/package-lock.json
client/node_modules/
client/.env
client/package-lock.json
node_modules/
package-lock.json

# Environment variables
.env
.env.local
.env.*.local
.env.example

# Sensitive gateway configurations
server/config/gateways/
server/config/secrets/
*.key
*.cert

# Laufzeit-Logs des Servers (enthalten E-Mail-Adressen/Betreffzeilen; werden vom Server selbst
# angelegt: utils/logger.js, utils/emailLogger.js - mkdir recursive, fehlende/leere/kaputte JSON tolerant)
server/logs/

# Laufzeit-Uploads mit Kundendaten (Pruefberichte, Rechnungen, Chat-/Nachrichtenanhaenge, CSV-Importe,
# Avatare). Die Verzeichnisse bleiben ueber .gitkeep erhalten; Katalogbilder (device-images) bleiben versioniert.
server/uploads/reports/*
server/uploads/invoices/*
server/uploads/chat/*
server/uploads/messages/*
server/uploads/csv/*
server/uploads/avatars/*
!server/uploads/*/.gitkeep

# Lauf-Ausgaben im Projektwurzelverzeichnis
/server_output.log
/test-results.log
